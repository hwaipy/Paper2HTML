{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwaipy.github.io/Paper2HTML/schema/0.1/validation-report.schema.json",
  "title": "Paper2HTML Validation Report 0.1",
  "type": "object",
  "required": ["$schema", "format", "format_version", "valid", "validated_at", "checks", "errors", "warnings"],
  "properties": {
    "$schema": {
      "const": "https://hwaipy.github.io/Paper2HTML/schema/0.1/validation-report.schema.json"
    },
    "format": { "const": "paper2html-validation-report" },
    "format_version": { "const": "0.1" },
    "valid": { "type": "boolean" },
    "validated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "checks": {
      "type": "object",
      "required": [
        "manifest_schema",
        "xml_well_formed",
        "jats_bits_schema",
        "p2h_profile",
        "id_uniqueness",
        "cross_references",
        "page_coverage",
        "element_provenance",
        "asset_integrity",
        "checksum_integrity"
      ],
      "properties": {
        "manifest_schema": { "$ref": "#/$defs/checkStatus" },
        "xml_well_formed": { "$ref": "#/$defs/checkStatus" },
        "jats_bits_schema": { "$ref": "#/$defs/checkStatus" },
        "p2h_profile": { "$ref": "#/$defs/checkStatus" },
        "id_uniqueness": { "$ref": "#/$defs/checkStatus" },
        "cross_references": { "$ref": "#/$defs/checkStatus" },
        "page_coverage": { "$ref": "#/$defs/checkStatus" },
        "element_provenance": { "$ref": "#/$defs/checkStatus" },
        "asset_integrity": { "$ref": "#/$defs/checkStatus" },
        "checksum_integrity": { "$ref": "#/$defs/checkStatus" }
      },
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": { "$ref": "#/$defs/checkStatus" }
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
      "then": {
        "properties": {
          "errors": { "type": "array", "maxItems": 0 },
          "checks": {
            "type": "object",
            "properties": {
              "manifest_schema": { "const": "passed" },
              "xml_well_formed": { "const": "passed" },
              "jats_bits_schema": { "const": "passed" },
              "p2h_profile": { "const": "passed" },
              "id_uniqueness": { "const": "passed" },
              "cross_references": { "const": "passed" },
              "page_coverage": { "const": "passed" },
              "element_provenance": { "const": "passed" },
              "asset_integrity": { "const": "passed" },
              "checksum_integrity": { "const": "passed" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "valid": { "const": false } }, "required": ["valid"] },
      "then": { "properties": { "errors": { "type": "array", "minItems": 1 } } }
    }
  ],
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "checkStatus": {
      "enum": ["passed", "failed", "partial", "not-run", "not-applicable"]
    },
    "finding": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "message": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "path": { "$ref": "common.schema.json#/$defs/packagePath" },
        "line": { "type": "integer", "minimum": 1 },
        "element_id": { "$ref": "common.schema.json#/$defs/elementId" },
        "source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
        "physical_page": { "type": "integer", "minimum": 1 }
      },
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
