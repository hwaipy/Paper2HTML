{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwaipy.github.io/Paper2HTML/schema/0.1/manifest.schema.json",
  "title": "Paper2HTML Package Manifest 0.1",
  "type": "object",
  "required": [
    "$schema",
    "format",
    "format_version",
    "package_id",
    "created_at",
    "generator",
    "document",
    "sources",
    "provenance",
    "validation",
    "checksums"
  ],
  "properties": {
    "$schema": {
      "const": "https://hwaipy.github.io/Paper2HTML/schema/0.1/manifest.schema.json"
    },
    "format": { "const": "paper2html-package" },
    "format_version": { "const": "0.1" },
    "package_id": {
      "type": "string",
      "format": "uri",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["id", "type", "profile", "language", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^doc-[0-9]{6}$" },
        "type": { "enum": ["book", "article", "thesis", "report", "other"] },
        "profile": { "enum": ["jats-1.3", "bits-2.1"] },
        "language": { "$ref": "common.schema.json#/$defs/languageTag" },
        "content": { "const": "content/document.xml" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "article" } }, "required": ["type"] },
          "then": { "properties": { "profile": { "const": "jats-1.3" } } }
        },
        {
          "if": { "properties": { "type": { "const": "book" } }, "required": ["type"] },
          "then": { "properties": { "profile": { "const": "bits-2.1" } } }
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "const": "primary" } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "provenance": {
      "type": "object",
      "required": ["pages", "elements", "omissions"],
      "properties": {
        "pages": { "const": "provenance/pages.jsonl" },
        "elements": { "const": "provenance/elements.jsonl" },
        "omissions": { "const": "provenance/omissions.jsonl" }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "const": "annotations/index.json" }
      },
      "additionalProperties": false
    },
    "validation": { "const": "validation/report.json" },
    "checksums": { "const": "checksums.sha256" }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "role",
        "original_name",
        "media_type",
        "sha256",
        "size",
        "page_count",
        "source_class",
        "extraction_modes",
        "embedded_path"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/sourceId" },
        "role": { "enum": ["primary", "alternate", "supplementary"] },
        "original_name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "media_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "page_count": { "type": "integer", "minimum": 1 },
        "source_class": { "enum": ["born-digital", "scanned", "hybrid"] },
        "extraction_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["native-pdf", "ocr", "manual"] }
        },
        "embedded_path": {
          "oneOf": [
            { "type": "null" },
            {
              "allOf": [
                { "$ref": "common.schema.json#/$defs/packagePath" },
                { "type": "string", "pattern": "^assets/sources/src-[0-9]{3}\\.[a-z0-9]+$" }
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "media_type": { "const": "application/pdf" } }, "required": ["media_type"] },
          "then": { "properties": { "extraction_modes": { "type": "array", "contains": { "const": "ocr" } } } }
        },
        {
          "if": { "properties": { "source_class": { "const": "born-digital" } }, "required": ["source_class"] },
          "then": {
            "properties": {
              "extraction_modes": {
                "type": "array",
                "allOf": [
                  { "contains": { "const": "native-pdf" } },
                  { "contains": { "const": "ocr" } }
                ]
              }
            }
          }
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
