{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwaipy.github.io/Paper2HTML/schema/0.1/annotation-index.schema.json",
  "title": "Paper2HTML Annotation Index 0.1",
  "type": "object",
  "required": ["$schema", "format", "format_version", "layers"],
  "properties": {
    "$schema": {
      "const": "https://hwaipy.github.io/Paper2HTML/schema/0.1/annotation-index.schema.json"
    },
    "format": { "const": "paper2html-annotation-index" },
    "format_version": { "const": "0.1" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["id", "kind", "language", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["translation", "definition", "commentary", "reading-note"] },
        "language": { "$ref": "common.schema.json#/$defs/languageTag" },
        "path": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/packagePath" },
            { "type": "string", "pattern": "^annotations/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.jsonl$" }
          ]
        }
      },
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
